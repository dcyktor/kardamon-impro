---
interface Props { name: string; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" /></>}
  {name === 'facebook' && <path d="M14.5 21v-7.2h2.4l.4-2.8h-2.8V9.1c0-.8.2-1.4 1.4-1.4h1.5V5.2C16.9 5.1 16 5 15 5c-2.3 0-3.9 1.4-3.9 4v2h-2.4v2.8h2.4V21" />}
  {name === 'tiktok' && <><path d="M14 4v10.4a3.2 3.2 0 1 1-2.4-3.1" /><path d="M14 4c.3 2 1.9 3.6 4 3.9" /></>}
  {name === 'youtube' && <><rect x="3" y="6" width="18" height="12" rx="4" /><path d="M10.5 9.7l4.2 2.3-4.2 2.3z" fill="currentColor" stroke="none" /></>}
  {name === 'person' && <><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" /></>}
</svg>
