---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EventCard from '../components/EventCard.astro';
import Icon from '../components/Icon.astro';
import JsonLd from '../components/JsonLd.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { Content as About } from '../data/o-nas.md';
import { isUpcoming, loadEvents, shortDate } from '../lib/events';
import { byName, warnHeic, warnUnmatched } from '../lib/images';
import { eventSchema, groupSchema } from '../lib/schema';

warnHeic();

const events = await loadEvents();
const upcoming = events.filter((e) => isUpcoming(e.date));
const past = events.filter((e) => !isUpcoming(e.date)).reverse(); // najnowsze pierwsze

// Główny przycisk w hero: podtytuł i data najbliższego spektaklu, link prosto do jego biletów.
// Kropka zamiast "na", bo podtytułów nie da się automatycznie odmienić ("na Improwizowaną Korporację").
// Twarde spacje ( ) przy kropkach: przy łamaniu na telefonie kropka i data nie zostają same w linii.
const next = upcoming[0];
const nextHasTickets = next && next.tickets && !next.soldOut && !next.free;
const heroTickets = nextHasTickets ? next.tickets! : site.ticketsUrl;

// Zdjęcia składu: src/assets/sklad/<imie-nazwisko>.jpg, dopasowane po imieniu i nazwisku.
const teamPhotos = byName(import.meta.glob<{ default: ImageMetadata }>(
  '../assets/sklad/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true }));
const slug = (name: string) => name.toLowerCase().replace(/ł/g, 'l').normalize('NFD')
  .replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const team = site.team.map((m) => ({ ...m, photo: teamPhotos.get(slug(m.name)) }));
warnUnmatched('skład', teamPhotos, site.team.map((m) => slug(m.name)));

// Karuzela w hero: wszystkie zdjęcia z src/assets/hero/, w kolejności alfabetycznej nazw plików.
// Bez zdjęć hero ma zielone tło jak dotąd.
const heroPhotos = Object.entries(import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

// Dane dla Google: grupa oraz nadchodzące spektakle (mogą pojawić się w wynikach wyszukiwania).
const structuredData = [groupSchema(Astro.site!), ...(await Promise.all(upcoming.map((e) => eventSchema(e, Astro.site!))))];
---
<Base>
  <JsonLd data={structuredData} />
  <Header />

  <main>
    <section class:list={['hero', { 'has-photos': heroPhotos.length > 0 }]} id="top">
      {heroPhotos.length > 0 && (
        <div class="hero-slides" aria-hidden="true">
          {heroPhotos.map((img, i) => (
            <Image src={img} alt="" width={1920} widths={[768, 1280, 1920]} sizes="100vw"
              class:list={['hero-slide', { active: i === 0 }]}
              loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          ))}
        </div>
      )}
      <div class="inner">
        <div class="hero-content">
          <h1><img src="/logo-napis.svg" alt={site.name} width="280" height="156" /></h1>
          <span class="kicker">{site.kicker}</span>
          <p>{site.tagline}</p>
          <a href={heroTickets} class="btn" target="_blank" rel="noopener">{nextHasTickets
            ? <>{next.subtitle ? `Bilety · ${next.subtitle} · ${shortDate(next.date)}` : `Bilety na ${shortDate(next.date)}`}<span class="sr">, {next.title}</span></>
            : 'Kup bilety'}</a>
          <div class="icons">
            {site.socials.map((s) => (
              <a href={s.url} class="icon-link" aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} /></a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section events" id="wydarzenia">
      <div class="container">
        <div class="section-head">
          <span class="kicker">Co gramy</span>
          <h2 class="serif">Wydarzenia</h2>
        </div>

        <!-- Zakładki pojawiają się dopiero z JS; bez JS obie listy są widoczne jedna pod drugą -->
        <div class="tabs" role="tablist" aria-label="Wydarzenia" hidden>
          <button role="tab" id="tab-upcoming" aria-controls="panel-upcoming" aria-selected="true">Nadchodzące</button>
          <button role="tab" id="tab-past" aria-controls="panel-past" aria-selected="false" tabindex="-1">Zakończone</button>
        </div>

        <div id="panel-upcoming" role="tabpanel" aria-labelledby="tab-upcoming">
          <h3 class="kicker no-js-label">Nadchodzące</h3>
          {upcoming.length === 0 ? (
            <p class="empty">Na razie nie mamy zaplanowanych występów. Nowe terminy ogłaszamy w social mediach.</p>
          ) : (
            <ul class="cards">{upcoming.map((e) => <EventCard event={e} />)}</ul>
          )}
        </div>

        <div id="panel-past" role="tabpanel" aria-labelledby="tab-past">
          <h3 class="kicker no-js-label">Zakończone</h3>
          {past.length === 0 ? (
            <p class="empty">Tu pojawią się zagrane już spektakle.</p>
          ) : (
            <ul class="cards">{past.map((e) => <EventCard event={e} past />)}</ul>
          )}
        </div>
      </div>
    </section>

    <section class="section about" id="o-nas">
      <div class="container">
        <div class="about-text">
          <span class="kicker">Kim jesteśmy</span>
          <h2 class="serif">O nas</h2>
          <div class="prose"><About /></div>
        </div>
        {site.team.length > 0 && (
          <div class="about-text" style="max-width:none">
            <span class="kicker">Skład</span>
            <ul class="cast">
              {team.map((m) => (
                <li>
                  {m.photo
                    ? <div class="photo"><Image src={m.photo} alt={m.name} width={600} /></div>
                    : <><div class="photo placeholder"><Icon name="person" size={32} /></div><span class="name">{m.name}</span></>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    // Zakładki Nadchodzące / Zakończone
    (function () {
      var tablist = document.querySelector('.tabs');
      var tabs = Array.prototype.slice.call(tablist.querySelectorAll('[role="tab"]'));
      tablist.hidden = false;
      document.querySelectorAll('.no-js-label').forEach(function (el) { el.hidden = true; });
      function select(tab) {
        tabs.forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', on);
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        });
      }
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () { select(t); });
        t.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            var n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
            select(n); n.focus();
          }
        });
      });
      select(tabs[0]);
    })();

    // Karuzela w hero: co 10 s płynne przejście do kolejnego zdjęcia (bez animacji, jeśli system prosi o mniej ruchu)
    (function () {
      var slides = document.querySelectorAll('.hero-slide');
      if (slides.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var i = 0;
      setInterval(function () {
        slides[i].classList.remove('active');
        i = (i + 1) % slides.length;
        slides[i].classList.add('active');
      }, 10000);
    })();
  </script>
</Base>
