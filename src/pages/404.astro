---
// Strona dla nieistniejących adresów. GitHub Pages sam serwuje dist/404.html zamiast swojej domyślnej strony.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---
<Base title={`Nie ma takiej strony · ${site.name}`} noindex>
  <Header />

  <main class="not-found">
    <div class="not-found-inner">
      <span class="kicker">Błąd 404</span>
      <h1 class="serif">Tej sceny nie ma w programie</h1>
      <p>Strona, której szukasz, nie istnieje – może zmienił się adres albo wkradła się literówka.</p>
      <div class="not-found-actions">
        <a href="/#wydarzenia" class="btn">Zobacz nadchodzące spektakle</a>
        <a href="/" class="not-found-home">Strona główna</a>
      </div>
    </div>
  </main>

  <Footer />
</Base>
